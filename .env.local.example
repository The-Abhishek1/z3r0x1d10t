# ============================================
# SUPABASE — get these from supabase.com > your project > Settings > API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# This is your SERVICE ROLE key (secret — never expose to client)
# Supabase > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ============================================
# ADMIN — your email used to sign in to Supabase Auth
# ============================================
NEXT_PUBLIC_ADMIN_EMAIL=your_email@gmail.com

# ============================================
# SITE
# ============================================
NEXT_PUBLIC_SITE_URL=https://0xidiot.vercel.app
